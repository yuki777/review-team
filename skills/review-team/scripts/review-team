#!/bin/bash

set -euo pipefail

# シンボリックリンク経由でも、実体の隣の VERSION を読む（readlink -f のない古い macOS でも動くようにたどる）
version() {
  local path="${BASH_SOURCE[0]}" target
  while [ -L "$path" ]; do
    target="$(readlink "$path")"
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
  done
  echo "v$(cat "$(dirname "$path")/../VERSION")"
}

usage() {
  echo "review-team $(version)" >&2
  cat >&2 <<'USAGE'
usage: review-team [--team <TEAM>] [--act-on-only] [--print] <PR-URL>
       review-team --version

TEAM はメンバー名を - でつないだもの（順不同）。書いた順がレビュアーの順になる。
メンバー名の後ろに :<effort> を付けると、そのレビュアーの reasoning effort を変えられる（省略時は high）。
例: opus:max-sol:xhigh-grok-argon:low
主担当の claude 自身の effort（xhigh）は変わらない。

Members:      CLI:モデル                 使える effort
  opus   claude:claude-opus-5-5    low medium high xhigh max
  fable  claude:claude-fable-5-1   low medium high xhigh max
  sol    codex:gpt-6.1-sol         low medium high xhigh max ultra
  astra  codex:gpt-6-astra         low medium high xhigh max ultra
  grok   grok:grok-4.7-build-fast  low medium high xhigh
  argon  agy:gemini-4-argon        low medium high

Teams (例):
  opus-sol             Claude Opus 5.5 + Codex GPT 6.1 Sol
  opus-sol-grok        opus-sol + Grok
  opus-sol-argon       opus-sol + Gemini (agy)
  opus-sol-grok-argon  既定と同じ4人
  fable-astra          Claude Fable 5.1 + Codex GPT 6 Astra
  opus:max-sol:xhigh   Opus は max、Sol は xhigh

--team を省略すると review-team の既定のレビュアー（config/reviewers.json）を使う。
レビュー結果はプレビューの承認を待たずに PR に投稿され（--comment）、
以後の push は自動で再レビューされる（--watch）。
--act-on-only を付けると、PR には Act On の指摘だけを投稿する（再レビューも同じ）。
--print を付けると、画面を出さずに claude -p で動かし、終わるまで待つ（launchd などから呼ぶとき）。
USAGE
}

# チームのメンバー名を <cli>:<model> と、使える effort に対応付ける
# （effort は claude 2.1.312・codex 0.164.0・grok 1.0.70・agy 1.4.8 で確かめた値）
member_spec() {
  case "$1" in
    opus)  echo "claude:claude-opus-5-5 low medium high xhigh max" ;;
    fable) echo "claude:claude-fable-5-1 low medium high xhigh max" ;;
    sol)   echo "codex:gpt-6.1-sol low medium high xhigh max ultra" ;;
    astra) echo "codex:gpt-6-astra low medium high xhigh max ultra" ;;
    grok)  echo "grok:grok-4.7-build-fast low medium high xhigh" ;;
    argon) echo "agy:gemini-4-argon low medium high" ;;
    *) return 1 ;;
  esac
}

fail() {
  echo "review-team: $1" >&2
  usage
  exit 1
}

TEAM=""
REVIEW_TARGET=""
ACT_ON_ONLY=""
PRINT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --team)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--team にチーム名を指定してください"
      TEAM="$2"
      shift 2
      ;;
    --team=*)
      TEAM="${1#--team=}"
      [ -n "$TEAM" ] || fail "--team にチーム名を指定してください"
      shift
      ;;
    --act-on-only)
      ACT_ON_ONLY=" --act-on-only"
      shift
      ;;
    --print)
      PRINT=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      echo "review-team $(version)"
      exit 0
      ;;
    -*)
      fail "不明なオプションです: $1"
      ;;
    *)
      [ -z "$REVIEW_TARGET" ] || fail "URL は1つだけ指定してください"
      REVIEW_TARGET="$1"
      shift
      ;;
  esac
done

if [ -z "$REVIEW_TARGET" ]; then
  usage
  exit 1
fi

reviewer_args=""
if [ -n "$TEAM" ]; then
  case "$TEAM" in
    *[!a-z:-]*|-*|*-|*--*) fail "不明なチームです: $TEAM" ;;
  esac
  seen=" "
  for item in ${TEAM//-/ }; do
    member="${item%%:*}"
    effort=high
    case "$item" in *:*) effort="${item#*:}" ;; esac
    spec="$(member_spec "$member")" || fail "不明なメンバーです: $member（チーム: $TEAM）"
    efforts=" ${spec#* } "
    case "$efforts" in
      *" $effort "*) ;;
      *) fail "$member の effort に $effort は使えません（使える effort:${efforts% }）" ;;
    esac
    case "$seen" in
      *" $member "*) fail "メンバーが重複しています: $member（チーム: $TEAM）" ;;
    esac
    seen="$seen$member "
    reviewer_args="$reviewer_args --reviewer ${spec%% *}:$effort"
  done
fi

work_root="${XDG_STATE_HOME:-$HOME/.local/state}/review-team"
mkdir -p "$work_root"
cd "$work_root"
exec claude ${PRINT:+-p} --effort xhigh --permission-mode auto "/review-team --comment --watch${ACT_ON_ONLY}${reviewer_args} $REVIEW_TARGET"
