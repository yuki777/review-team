#!/bin/bash

set -euo pipefail

# シンボリックリンク経由でも、実体のあるディレクトリを返す（readlink -f のない古い macOS でも動くようにたどる）
script_dir() {
  local path="${BASH_SOURCE[0]}" target
  while [ -L "$path" ]; do
    target="$(readlink "$path")"
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
  done
  dirname "$path"
}

version() {
  echo "v$(cat "$(script_dir)/../VERSION")"
}

# GitHub の最新リリースと版が違えば、1行だけ警告する（確かめられなくても止めない）
warn_if_outdated() {
  local latest current
  latest="$(gh api repos/yuki777/review-team/releases/latest --jq .tag_name 2>/dev/null)" || return 0
  current="$(version)"
  [ -z "$latest" ] || [ "$latest" = "$current" ] ||
    echo "rt: 新しい版 $latest があります（いまは $current）。npx skills update review-team -g（git のチェックアウトなら git pull。--loop は止めてから）で更新してください" >&2
}

usage() {
  echo "rt $(version)"
  cat <<'USAGE'

使い方:
  rt [--team <TEAM>] [--with-consider] [--print] [--force] <PR-URL>
  rt --loop (--org <組織> | --repo <owner/name>...) [--interval <分>] [--team <TEAM>] [--with-consider]
  rt --help | --version

説明:
  PR を review-team でレビューし、結果をそのまま PR に投稿するコマンド。
  どのディレクトリから実行しても、状態ディレクトリ（${XDG_STATE_HOME:-~/.local/state}/review-team）で
  claude を起動して /review-team --comment --watch <PR-URL> を実行する。そのため、
    - プレビューの承認を待たずに、PR へ Act On（要対応）の指摘をインラインコメント
      （差分の外の指摘は総評）で投稿する
    - 投稿後は PR をウォッチし、新しい push が落ち着いたら（5分以上）自動で再レビュー・投稿する
      （PR のマージかクローズ、12時間、再レビュー5回のどれかで終わる。draft の間は見送る。
      見回りは macOS では launchd に自動で登録し、Linux では表示される cron の行を crontab に足す）
  主担当の claude は effort xhigh、権限確認は auto で動く。
  claude を起動する前に GitHub で PR の head を確かめ、次のときは claude を起動せずに見送る（終了ステータス 0）。
    - 同じ PR のレビュー（別の rt・scan・ウォッチの再レビュー）が実行中
    - head がレビュー済み（投稿まで終えた commit と同じ）。--force を付けるとやり直す
  レビュー中の PR は、投稿を終えるか claude が終わるまで、ほかの rt・scan・ウォッチの再レビューから見送られる。
  起動のたび（--loop では scan のたび）に GitHub の最新リリースを確かめ、版が違えば標準エラーに警告を1行出す。

オプション:
  --team <TEAM>
      レビュアーを、既定（config/reviewers.json）の代わりに TEAM の顔ぶれにする。
      TEAM の書き方は下の「チーム」を参照。--team=<TEAM> の形でもよい。
  --with-consider
      Act On に加えて、Consider（要検討）の指摘も PR に投稿する。付けないと Act On だけを投稿する。
      ウォッチ中の再レビューにも引き継がれる。
  --force
      head がレビュー済みでも、もう一度レビューして投稿する。実行中のレビューがあれば、これを付けても見送る。
  --print
      対話画面を出さずに claude -p で動かし、レビューと投稿が終わるまで待ってから戻る。
      launchd などから自動で呼ぶとき用。--loop とは一緒に使えない。
  --loop
      PR を1件指定する代わりに、自分にレビュー依頼が来ている PR を探してレビューする scan を繰り返す。
      scan が終わるたびに --interval 分待ち、また scan する。Ctrl-C で止まる。
      --org か --repo のどちらか一方が必要（両方は指定できない）。
      対象は open で draft でない PR（Renovate の PR とアーカイブ済みリポジトリを除く）。
      コンフリクト・CI の失敗か実行中・ウォッチ中・レビュー中・同じ head でレビュー済みの PR は見送る。
      レビューが投稿まで終わらなかった head は、次の scan で1回だけやり直し、それも失敗したら新しい push まで見送る。
  --org <組織>
      --loop で、この GitHub の組織の全リポジトリを探す。
  --repo <owner/name>
      --loop で、このリポジトリだけを探す。複数回指定でき、別の組織のリポジトリも混ぜられる。
  --interval <分>
      --loop で scan と scan の間に待つ分。1以上の整数。省略すると 10。
  -h, --help
      このヘルプを出して終わる。
  --version
      版（rt vX.Y.Z）を出して終わる。

  --org・--repo・--interval は --loop と一緒のときだけ使え（--force は --loop と一緒には使えない）、「--org 名前」の形だけ受け付ける。
  名前だけの --repo（owner/ なし）と、--org と --repo の併用はエラーになる（GitHub の検索では org: と repo: が絞り込みでなく和集合になるため）。

チーム:
  TEAM はメンバー名を - でつないだもの（順不同）。書いた順がレビュアーの順になる。
  メンバー名の後ろに :<effort> を付けると、そのレビュアーの reasoning effort を変えられる（省略すると high）。
  主担当の claude 自身の effort（xhigh）は変わらない。

  名前   CLI:モデル                使える effort
  opus   claude:claude-opus-5-5    low medium high xhigh max
  fable  claude:claude-fable-5-2   low medium high xhigh max
  sol    codex:gpt-6.1-sol         low medium high xhigh max ultra
  astra  codex:gpt-6-astra         low medium high xhigh max ultra

例:
  rt https://github.com/OWNER/REPO/pull/123
      既定のレビュアーでレビューして投稿し、以後の push も自動で再レビューする
  rt --team opus:max-sol:xhigh https://github.com/OWNER/REPO/pull/123
      Opus（effort max）と Sol（effort xhigh）の2人でレビューする
  rt --with-consider https://github.com/OWNER/REPO/pull/123
      Consider の指摘も投稿する
  rt --loop --repo OWNER/REPO --repo OTHER/REPO --interval 30
      OWNER/REPO と OTHER/REPO で自分にレビュー依頼が来た PR を、30分おきに探してレビューする

終了ステータス:
  オプションや引数が正しくないときは 1。--help・--version と、レビューを見送ったときは 0。
  GitHub に PR を問い合わせられないなど、claude を起動する前に失敗したときは 2。
  それ以外は claude の終了ステータスを返す。--loop は Ctrl-C で止めるまで戻らない。
USAGE
}

# チームのメンバー名を <cli>:<model> と、使える effort に対応付ける
# （effort は claude 2.1.312・codex 0.164.0 で確かめた値）
member_spec() {
  case "$1" in
    opus)  echo "claude:claude-opus-5-5 low medium high xhigh max" ;;
    fable) echo "claude:claude-fable-5-2 low medium high xhigh max" ;;
    sol)   echo "codex:gpt-6.1-sol low medium high xhigh max ultra" ;;
    astra) echo "codex:gpt-6-astra low medium high xhigh max ultra" ;;
    *) return 1 ;;
  esac
}

fail() {
  echo "rt: $1" >&2
  echo "詳しくは rt --help" >&2
  exit 1
}

TEAM=""
REVIEW_TARGET=""
WITH_CONSIDER=""
PRINT=""
FORCE=""
LOOP=""
ORG=""
REPOS=""
INTERVAL=""

while [ $# -gt 0 ]; do
  case "$1" in
    --team)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--team にチーム名を指定してください"
      TEAM="$2"
      shift 2
      ;;
    --team=*)
      TEAM="${1#--team=}"
      [ -n "$TEAM" ] || fail "--team にチーム名を指定してください"
      shift
      ;;
    --with-consider)
      WITH_CONSIDER=1
      shift
      ;;
    --print)
      PRINT=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    --loop)
      LOOP=1
      shift
      ;;
    --org)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--org に組織名を指定してください"
      ORG="$2"
      shift 2
      ;;
    --repo)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--repo に owner/name を指定してください"
      case "$2" in
        */*/*|*[!A-Za-z0-9._/-]*|-*|/*|*/|*/-*) fail "--repo は owner/name の形で指定してください: $2" ;;
        */*) ;;
        *) fail "--repo は owner/name の形で指定してください: $2" ;;
      esac
      REPOS="$REPOS --repo $2"
      shift 2
      ;;
    --interval)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--interval に分を指定してください"
      INTERVAL="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      echo "rt $(version)"
      exit 0
      ;;
    -*)
      fail "不明なオプションです: $1"
      ;;
    *)
      [ -z "$REVIEW_TARGET" ] || fail "URL は1つだけ指定してください"
      REVIEW_TARGET="$1"
      shift
      ;;
  esac
done

if [ -n "$LOOP" ]; then
  [ -z "$REVIEW_TARGET" ] || fail "--loop と URL は同時に指定できません"
  [ -z "$PRINT" ] || fail "--loop と --print は同時に指定できません"
  [ -z "$FORCE" ] || fail "--loop と --force は同時に指定できません"
  { [ -n "$ORG" ] || [ -n "$REPOS" ]; } && { [ -z "$ORG" ] || [ -z "$REPOS" ]; } ||
    fail "--loop には --org か --repo のどちらか一方を指定してください"
  INTERVAL="${INTERVAL:-10}"
  case "$INTERVAL" in
    ''|0*|*[!0-9]*) fail "--interval は1以上の整数（分）で指定してください: $INTERVAL" ;;
  esac
else
  [ -z "$ORG$REPOS$INTERVAL" ] || fail "--org・--repo・--interval は --loop と一緒に指定してください"
  [ -n "$REVIEW_TARGET" ] || fail "PR の URL を指定してください"
fi

reviewer_args=""
if [ -n "$TEAM" ]; then
  case "$TEAM" in
    *[!a-z:-]*|-*|*-|*--*) fail "不明なチームです: $TEAM" ;;
  esac
  seen=" "
  for item in ${TEAM//-/ }; do
    member="${item%%:*}"
    effort=high
    case "$item" in *:*) effort="${item#*:}" ;; esac
    spec="$(member_spec "$member")" || fail "不明なメンバーです: $member（チーム: $TEAM）"
    efforts=" ${spec#* } "
    case "$efforts" in
      *" $effort "*) ;;
      *) fail "$member の effort に「$effort」は使えません（使える effort:${efforts% }）" ;;
    esac
    case "$seen" in
      *" $member "*) fail "メンバーが重複しています: $member（チーム: $TEAM）" ;;
    esac
    seen="$seen$member "
    reviewer_args="$reviewer_args --reviewer ${spec%% *}:$effort"
  done
fi

if [ -n "$LOOP" ]; then
  scanner="$(script_dir)/scan-prs.mjs"
  while :; do
    warn_if_outdated
    # scan が失敗しても（gh の一時的な失敗など）、次の回にまた試す
    node "$scanner" scan ${ORG:+--org "$ORG"}$REPOS ${TEAM:+--team "$TEAM"} ${WITH_CONSIDER:+--with-consider} || true
    sleep $((INTERVAL * 60))
  done
fi

warn_if_outdated
work_root="${XDG_STATE_HOME:-$HOME/.local/state}/review-team"
mkdir -p "$work_root"
# script_dir can be relative, so pr-lock.mjs is found before leaving the current directory.
lock_script="$(cd "$(script_dir)" && pwd)/pr-lock.mjs"
cd "$work_root"
# The lock is taken in this shell's pid, which exec hands to claude, so it is held while claude runs.
# The lead's record or defer releases it once the review is over, even if the session stays open.
status=0
out="$(node "$lock_script" acquire ${FORCE:+--force} --pid $$ "$REVIEW_TARGET")" || status=$?
case "$status" in
  # The URL as GitHub writes it, which the lead records too, so the lock and the record stay in one place.
  0) REVIEW_TARGET="$out" ;;
  3) echo "$out"; exit 0 ;;
  *) exit "$status" ;;
esac
export REVIEW_TEAM_PR_LOCK=$$
exec claude ${PRINT:+-p} --effort xhigh --permission-mode auto "/review-team --comment --watch${WITH_CONSIDER:+ --with-consider}${reviewer_args} $REVIEW_TARGET"
