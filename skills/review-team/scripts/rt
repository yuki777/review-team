#!/bin/bash

set -euo pipefail

# シンボリックリンク経由でも、実体のあるディレクトリを返す（readlink -f のない古い macOS でも動くようにたどる）
script_dir() {
  local path="${BASH_SOURCE[0]}" target
  while [ -L "$path" ]; do
    target="$(readlink "$path")"
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
  done
  dirname "$path"
}

version() {
  echo "v$(cat "$(script_dir)/../VERSION")"
}

usage() {
  echo "rt $(version)"
  cat <<'USAGE'

使い方:
  rt [--team <TEAM>] [--with-consider] [--print] <PR-URL>
  rt --loop --org <組織> [--repo <名前>]... [--interval <分>] [--team <TEAM>] [--with-consider]
  rt --help | --version

説明:
  PR を review-team でレビューし、結果をそのまま PR に投稿するコマンド。
  どのディレクトリから実行しても、状態ディレクトリ（${XDG_STATE_HOME:-~/.local/state}/review-team）で
  claude を起動して /review-team --comment --watch <PR-URL> を実行する。そのため、
    - プレビューの承認を待たずに、PR へ Act On（要対応）の指摘をインラインコメント
      （差分の外の指摘は総評）で投稿する
    - 投稿後は PR をウォッチし、新しい push が落ち着いたら（5分以上）自動で再レビュー・投稿する
      （PR のマージかクローズ、6時間、再レビュー5回のどれかで終わる。draft の間は見送る。
      見回りは macOS では launchd に自動で登録し、Linux では表示される cron の行を crontab に足す）
  主担当の claude は effort xhigh、権限確認は auto で動く。

オプション:
  --team <TEAM>
      レビュアーを、既定（config/reviewers.json）の代わりに TEAM の顔ぶれにする。
      TEAM の書き方は下の「チーム」を参照。--team=<TEAM> の形でもよい。
  --with-consider
      Act On に加えて、Consider（要検討）の指摘も PR に投稿する。付けないと Act On だけを投稿する。
      ウォッチ中の再レビューにも引き継がれる。
  --print
      対話画面を出さずに claude -p で動かし、レビューと投稿が終わるまで待ってから戻る。
      launchd などから自動で呼ぶとき用。--loop とは一緒に使えない。
  --loop
      PR を1件指定する代わりに、自分にレビュー依頼が来ている PR を探してレビューする scan を繰り返す。
      scan が終わるたびに --interval 分待ち、また scan する。Ctrl-C で止まる。--org が必要。
      対象は open で draft でない PR（Renovate の PR とアーカイブ済みリポジトリを除く）。
      コンフリクト・CI の失敗か実行中・ウォッチ中・同じ head でレビュー済みの PR は見送る。
  --org <組織>
      --loop で探す GitHub の組織。
  --repo <名前>
      --loop で探す範囲を、組織の中のこのリポジトリに絞る（owner/ は付けない）。複数回指定できる。
  --interval <分>
      --loop で scan と scan の間に待つ分。1以上の整数。省略すると 15。
  -h, --help
      このヘルプを出して終わる。
  --version
      版（rt vX.Y.Z）を出して終わる。

  --org・--repo・--interval は --loop と一緒のときだけ使え、「--org 名前」の形だけ受け付ける。

チーム:
  TEAM はメンバー名を - でつないだもの（順不同）。書いた順がレビュアーの順になる。
  メンバー名の後ろに :<effort> を付けると、そのレビュアーの reasoning effort を変えられる（省略すると high）。
  主担当の claude 自身の effort（xhigh）は変わらない。

  名前   CLI:モデル                使える effort
  opus   claude:claude-opus-5-5    low medium high xhigh max
  fable  claude:claude-fable-5-2   low medium high xhigh max
  sol    codex:gpt-6.1-sol         low medium high xhigh max ultra
  astra  codex:gpt-6-astra         low medium high xhigh max ultra

例:
  rt https://github.com/OWNER/REPO/pull/123
      既定のレビュアーでレビューして投稿し、以後の push も自動で再レビューする
  rt --team opus:max-sol:xhigh https://github.com/OWNER/REPO/pull/123
      Opus（effort max）と Sol（effort xhigh）の2人でレビューする
  rt --with-consider https://github.com/OWNER/REPO/pull/123
      Consider の指摘も投稿する
  rt --loop --org OWNER --repo REPO --interval 30
      OWNER/REPO で自分にレビュー依頼が来た PR を、30分おきに探してレビューする

終了ステータス:
  オプションや引数が正しくないときは 1。--help・--version は 0。
  それ以外は claude の終了ステータスを返す。--loop は Ctrl-C で止めるまで戻らない。
USAGE
}

# チームのメンバー名を <cli>:<model> と、使える effort に対応付ける
# （effort は claude 2.1.312・codex 0.164.0 で確かめた値）
member_spec() {
  case "$1" in
    opus)  echo "claude:claude-opus-5-5 low medium high xhigh max" ;;
    fable) echo "claude:claude-fable-5-2 low medium high xhigh max" ;;
    sol)   echo "codex:gpt-6.1-sol low medium high xhigh max ultra" ;;
    astra) echo "codex:gpt-6-astra low medium high xhigh max ultra" ;;
    *) return 1 ;;
  esac
}

fail() {
  echo "rt: $1" >&2
  echo "詳しくは rt --help" >&2
  exit 1
}

TEAM=""
REVIEW_TARGET=""
WITH_CONSIDER=""
PRINT=""
LOOP=""
ORG=""
REPOS=""
INTERVAL=""

while [ $# -gt 0 ]; do
  case "$1" in
    --team)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--team にチーム名を指定してください"
      TEAM="$2"
      shift 2
      ;;
    --team=*)
      TEAM="${1#--team=}"
      [ -n "$TEAM" ] || fail "--team にチーム名を指定してください"
      shift
      ;;
    --with-consider)
      WITH_CONSIDER=1
      shift
      ;;
    --print)
      PRINT=1
      shift
      ;;
    --loop)
      LOOP=1
      shift
      ;;
    --org)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--org に組織名を指定してください"
      ORG="$2"
      shift 2
      ;;
    --repo)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--repo にリポジトリ名を指定してください"
      case "$2" in
        *[!A-Za-z0-9._-]*|-*) fail "--repo には --org の中のリポジトリ名だけを指定してください: $2" ;;
      esac
      REPOS="$REPOS --repo $2"
      shift 2
      ;;
    --interval)
      [ $# -ge 2 ] && [ -n "$2" ] || fail "--interval に分を指定してください"
      INTERVAL="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      echo "rt $(version)"
      exit 0
      ;;
    -*)
      fail "不明なオプションです: $1"
      ;;
    *)
      [ -z "$REVIEW_TARGET" ] || fail "URL は1つだけ指定してください"
      REVIEW_TARGET="$1"
      shift
      ;;
  esac
done

if [ -n "$LOOP" ]; then
  [ -z "$REVIEW_TARGET" ] || fail "--loop と URL は同時に指定できません"
  [ -z "$PRINT" ] || fail "--loop と --print は同時に指定できません"
  [ -n "$ORG" ] || fail "--loop には --org が必要です"
  INTERVAL="${INTERVAL:-15}"
  case "$INTERVAL" in
    ''|0*|*[!0-9]*) fail "--interval は1以上の整数（分）で指定してください: $INTERVAL" ;;
  esac
else
  [ -z "$ORG$REPOS$INTERVAL" ] || fail "--org・--repo・--interval は --loop と一緒に指定してください"
  [ -n "$REVIEW_TARGET" ] || fail "PR の URL を指定してください"
fi

reviewer_args=""
if [ -n "$TEAM" ]; then
  case "$TEAM" in
    *[!a-z:-]*|-*|*-|*--*) fail "不明なチームです: $TEAM" ;;
  esac
  seen=" "
  for item in ${TEAM//-/ }; do
    member="${item%%:*}"
    effort=high
    case "$item" in *:*) effort="${item#*:}" ;; esac
    spec="$(member_spec "$member")" || fail "不明なメンバーです: $member（チーム: $TEAM）"
    efforts=" ${spec#* } "
    case "$efforts" in
      *" $effort "*) ;;
      *) fail "$member の effort に「$effort」は使えません（使える effort:${efforts% }）" ;;
    esac
    case "$seen" in
      *" $member "*) fail "メンバーが重複しています: $member（チーム: $TEAM）" ;;
    esac
    seen="$seen$member "
    reviewer_args="$reviewer_args --reviewer ${spec%% *}:$effort"
  done
fi

if [ -n "$LOOP" ]; then
  scanner="$(script_dir)/scan-prs.mjs"
  while :; do
    # scan が失敗しても（gh の一時的な失敗など）、次の回にまた試す
    node "$scanner" scan --org "$ORG"$REPOS ${TEAM:+--team "$TEAM"} ${WITH_CONSIDER:+--with-consider} || true
    sleep $((INTERVAL * 60))
  done
fi

work_root="${XDG_STATE_HOME:-$HOME/.local/state}/review-team"
mkdir -p "$work_root"
cd "$work_root"
exec claude ${PRINT:+-p} --effort xhigh --permission-mode auto "/review-team --comment --watch${WITH_CONSIDER:+ --with-consider}${reviewer_args} $REVIEW_TARGET"
